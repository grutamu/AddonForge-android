<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
  <shortcut
    android:shortcutId="update_all"
    android:enabled="true"
    android:icon="@mipmap/ic_launcher"
    android:shortcutShortLabel="@string/shortcut_update_short"
    android:shortcutLongLabel="@string/shortcut_update_long">
    <intent
      android:action="android.intent.action.VIEW"
      android:targetPackage="io.github.grutamu.addonforge"
      android:targetClass="io.github.grutamu.addonforge.MainActivity">
      <extra android:name="af_action" android:value="update-all" />
    </intent>
  </shortcut>
</shortcuts>
